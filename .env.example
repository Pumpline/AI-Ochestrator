# Kopieren nach .env und Werte setzen. .env ist in .gitignore.

# Infrastruktur (Tag 1)
POSTGRES_PASSWORD=change-me
AGENTOPS_PASSWORD=change-me
GRAFANA_RO_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Wo Grafana hört. Lokal weglassen (=127.0.0.1). Auf srv1: die Tailscale-IP, nie die öffentliche.
# BIND_ADDR=<Tailscale-IP>

# OpenClaw-Container (docker compose --profile openclaw)
# Host-Verzeichnis für Konfig, State und Workspace; Besitzer muss AGENTOPS_UID sein. srv1: /opt/agentops/openclaw
OPENCLAW_HOME_DIR=/opt/agentops/openclaw
# Repos, an denen die Agenten arbeiten. srv1: /opt/repos
OPENCLAW_REPOS_DIR=/opt/repos
# Gateway-Token, gilt für Gateway und Connector. openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Provider-Schlüssel für die Agenten. Eintragen ohne History: read -rsp "Key: " K; echo "OPENAI_API_KEY=$K" >> .env; unset K
OPENAI_API_KEY=

# Cockpit-Anmeldung über Discord (Developer Portal → Applications → OAuth2)
# Redirect URI dort exakt so eintragen wie hier. Allowlist: Discord-User-IDs, kommagetrennt. Root darf immer.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://srv1:5080/api/auth/discord/callback
DISCORD_ALLOWED_IDS=
DISCORD_ROOT_ID=
# Session-Schlüssel und andere Daten des Cockpits (Besitzer: AGENTOPS_UID)
AGENTOPS_DATA_DIR=/opt/agentops/data

# AgentOps-Container (docker compose --profile app)
# Bearer-Token für /api/*. Leer lassen = API aus (503). openssl rand -hex 32
API_TOKEN=
# Datenbank für Fixture-Tests statt des echten Logs (nur beim Aufruf setzen, nicht dauerhaft):
# AGENTOPS_DB=agentops_dev
# Verzeichnis mit openclaw.sqlite auf dem Host. srv1: Home des OpenClaw-Users, sobald es ihn gibt.
OPENCLAW_STATE_DIR=/home/openclaw/.openclaw/state
# Besitzer dieses Verzeichnisses (id -u openclaw / id -g openclaw)
AGENTOPS_UID=1000
AGENTOPS_GID=1000
