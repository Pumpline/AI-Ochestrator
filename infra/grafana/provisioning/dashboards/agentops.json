{
  "uid": "agentops",
  "title": "Agent-Ops",
  "description": "Die drei Fragen aus P3: Welche Flows warten auf mich? Was hat Agent X diese Woche gekostet? Warum ist Flow Y stehen geblieben?",
  "tags": ["agentops"],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Wartet auf mich — offene Gates",
      "description": "Flows mit gate_open. Freigabe passiert im Orchestrator, nicht hier (§11).",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "agentops-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select flow_id, stage, open_approval_id as approval, updated_at as seit from readmodel.flows where gate_open order by updated_at"
        }
      ],
      "options": { "showHeader": true, "sortBy": [] },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Stehen geblieben",
      "description": "status in failed, lost, blocked. Der Grund steht im Log: /api/flows/{id}/events.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "agentops-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select flow_id, stage, status, revision, updated_at as seit from readmodel.flows where status in ('failed','lost','blocked') order by updated_at desc"
        }
      ],
      "options": { "showHeader": true, "sortBy": [] },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flows nach Status",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "agentops-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select status, count(*)::int as anzahl from readmodel.flows group by status order by 2 desc"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^anzahl$/", "values": true },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kosten pro Modell (USD, je Tag)",
      "description": "openclaw.cost.usd aus dem OTel-Exporter (diagnostics.otel.metrics muss an sein), über Prometheus als openclaw_cost_usd_total.",
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (openclaw_model) (increase(openclaw_cost_usd_total[1d]))",
          "legendFormat": "{{openclaw_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Kosten seit Gateway-Start (USD)",
      "description": "Kumulierter Zähler; springt bei Neustart des Gateways auf 0. increase() verliert den ersten Sprung einer neuen Serie — deshalb hier die Summe, daneben die Tagesdeltas.",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(openclaw_cost_usd_total)", "legendFormat": "USD" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens pro Turn-Art (7 Tage)",
      "description": "prompt = gesamter Kontext je Aufruf. Ein Agent mit 50k Kontext kostet pro Turn, was ein kleiner Agent am Tag kostet (§1).",
      "gridPos": { "x": 6, "y": 14, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (openclaw_token) (increase(openclaw_tokens_total[1d]))", "legendFormat": "{{openclaw_token}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Alle Flows",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "agentops-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select flow_id, stage, status, gate_open, revision, updated_at from readmodel.flows order by updated_at desc"
        }
      ],
      "options": { "showHeader": true, "sortBy": [] },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
