<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0 (LTS): Marten 9 unterstützt nur noch net9/net10. Lokal SDK 10.0.400, Image mcr .../sdk:10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet user-secrets set "ConnectionStrings:AgentOps" "Host=127.0.0.1;Database=agentops;Username=agentops;Password=..." -->
    <UserSecretsId>agentops-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Event-Store, Projektionen, Async-Daemon, Rebuild (§14 Schritt 3).
         Nicht unter 8.37: CVE-2026-45288 (SQL-Injection in der Volltextsuche, GHSA-vmw2-qwm8-x84c). -->
    <PackageReference Include="Marten" Version="9.31.2" />
  </ItemGroup>

</Project>
